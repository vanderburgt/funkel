# PodcastIndex API — get free keys at https://api.podcastindex.org
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=

# Optional: Decodo ISP proxy. When set, ALL outbound traffic (PodcastIndex,
# audio, artwork) exits through the proxy so the server's IP is never
# revealed to podcast hosts or trackers. Leave empty to fetch directly.
DECODO_USERNAME=
DECODO_PASSWORD=
# DECODO_HOST=isp.decodo.com
# DECODO_PORT=10001

# Optional but recommended: encrypt the database at rest (ChaCha20-Poly1305).
# Generate with:  openssl rand -hex 32
# Set BEFORE first launch — an existing plaintext db can't be opened with a
# key, and an encrypted one can't be opened without it. Store the key in your
# deployment platform's secrets, never on the volume.
DB_ENCRYPTION_KEY=

# Where the SQLite database lives (mount a volume here in production)
# DATA_DIR=/data

# PORT=3000
